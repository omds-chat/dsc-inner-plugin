# 本地联调地址:cp .env.example .env 后生效,这份 .env 不进 git
#
# 本地 npm registry 模拟器;留空或删除则校验脚本用官方源
# 模拟器在 组织仓库(.github)的 tools/dev-local-npmjs:node ../awesome-dsc-plugin/scripts/dev/npm-registry-mock.mjs
# (默认端口 61116,用法见该仓库 README「本地校验」)
# 真实环境变量优先于 .env:命令行 --registry 优先级最高,其次是环境变量 NPM_REGISTRY_URL
NPM_REGISTRY_URL=http://127.0.0.1:61116/
