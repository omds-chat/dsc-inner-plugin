{
  "name": "dsc-inner-plugin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "dsc 组织自研插件合集: 按分发规范 v2 收录、签名并分发插件",
  "license": "Apache-2.0",
  "homepage": "https://omdsc-dev.github.io/dsc-inner-plugin/",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsc-dev/dsc-inner-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "node scripts/import-plugins.mjs --manifest .github/plugins-sources.json",
    "verify": "node scripts/verify-collection.mjs --dir . --allow-placeholder-eec",
    "verify:strict": "node scripts/verify-collection.mjs --dir .",
    "build": "node scripts/build-collection.mjs --dir . --allow-placeholder-eec --out dist",
    "sign": "node scripts/build-collection.mjs --dir . --sign --out dist"
  },
  "keywords": [
    "dsc",
    "dsc-plugin",
    "plugin-collection",
    "in-house",
    "openssl",
    "pki"
  ]
}
