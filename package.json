{
  "name": "dsc-inner-plugin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "dsc 背书的内部插件索引: 收录从 dsce 本体解耦出的可选内部插件,整站由 dsc 签名,插件由 dsc 作为作者签名",
  "license": "Apache-2.0",
  "homepage": "https://omdsc-dev.github.io/dsc-inner-plugin/",
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsc-dev/dsc-inner-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "import": "node scripts/import-plugins.mjs --manifest .github/plugins-sources.json",
    "verify": "node scripts/verify-collection.mjs --dir .",
    "build": "node scripts/build-collection.mjs --dir . --out dist",
    "sign": "node scripts/sign-site.mjs --dir dist",
    "verify:site": "node scripts/verify-site.mjs --dir dist"
  },
  "keywords": [
    "dsc",
    "dsc-plugin",
    "plugin-index",
    "in-house",
    "openssl",
    "pki"
  ]
}
